# API gateway for the local Supabase services (what Kong does on Supabase).
# ${API_PORT} is filled in by the nginx image when the container starts.

# Docker's DNS, re-resolved so a restarted service is found again.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen ${API_PORT};
    client_max_body_size 60m;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    set $auth_upstream auth:9999;
    set $rest_upstream rest:3000;
    set $storage_upstream storage:5000;

    location /auth/v1/ {
        include /etc/nginx/snippets/cors.conf;
        rewrite ^/auth/v1/(.*)$ /$1 break;
        proxy_pass http://$auth_upstream;
    }

    location /rest/v1/ {
        include /etc/nginx/snippets/cors.conf;
        rewrite ^/rest/v1/(.*)$ /$1 break;
        proxy_pass http://$rest_upstream;
    }

    location /storage/v1/ {
        include /etc/nginx/snippets/cors.conf;
        rewrite ^/storage/v1/(.*)$ /$1 break;
        proxy_pass http://$storage_upstream;
    }

    location / {
        return 404;
    }
}

# Email templates for Supabase Auth (invite, password reset). Internal only.
server {
    listen 8088;

    location /email/ {
        alias /usr/share/nginx/email/;
    }
}
